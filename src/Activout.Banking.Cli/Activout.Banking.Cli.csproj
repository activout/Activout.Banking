  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Activout.Banking/Activout.Banking.csproj" />
    <InternalsVisibleTo Include="Activout.Banking.Cli.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
