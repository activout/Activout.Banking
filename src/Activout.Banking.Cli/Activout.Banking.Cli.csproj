<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bank</AssemblyName>
    <RootNamespace>Activout.Banking.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bank</ToolCommandName>
    <PackageId>Activout.Banking.Cli</PackageId>
    <Description>The bank command: archive and export your own bank transactions through Enable Banking.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
